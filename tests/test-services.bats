#!/usr/bin/env bats
# Tests for test/render-services.sh (Caddy of the TEST VM) and the deploy sudoers rule
# (test/lib/test-host.sh).

setup() {
  ROOT="$(cd "$BATS_TEST_DIRNAME/.." && pwd)"
  RENDER="$ROOT/test/render-services.sh"
  CFG="$BATS_TEST_TMPDIR/kit.env"
  OUT="$BATS_TEST_TMPDIR/out"
  mkdir -p "$OUT"
  cp "$ROOT/tests/fixtures/valid.env" "$CFG"
  unset ADK_TLS_INTERNAL
}

set_var() {
  K="$1" V="$2" awk 'index($0, ENVIRON["K"]"=")==1 {print ENVIRON["K"]"="ENVIRON["V"]; next} {print}' "$CFG" > "$CFG.tmp"
  mv "$CFG.tmp" "$CFG"
}

refute() {
  if "$@"; then return 1; fi
}

y() {
  python3 -c 'import sys, yaml; c = yaml.safe_load(open(sys.argv[1])); print(eval(sys.argv[2]))' "$1" "$2"
}

need_yaml() {
  python3 -c 'import yaml' 2>/dev/null || skip "python3-yaml not installed"
}

@test "dns01: one wildcard site for TEST_DOMAIN with the project handlers imported" {
  run "$RENDER" --config "$CFG" --out "$OUT"
  [ "$status" -eq 0 ]
  grep -qx '\*.test.example.com {' "$OUT/Caddyfile"
  grep -qx '	import /etc/caddy/sites/\*.caddy' "$OUT/Caddyfile"
  grep -qx '		abort' "$OUT/Caddyfile"
  grep -qx '	acme_dns hetzner {env.DNS_API_TOKEN}' "$OUT/Caddyfile"
  [ -f "$OUT/caddy/Dockerfile" ]
  grep -q 'Generated by test/render-services.sh' "$OUT/caddy/Dockerfile"
}

@test "http01: per-site blocks imported at top level, stock image, no Dockerfile" {
  set_var ACME_MODE http01
  run "$RENDER" --config "$CFG" --out "$OUT"
  [ "$status" -eq 0 ]
  grep -qx 'import /etc/caddy/sites/\*.caddy' "$OUT/Caddyfile"
  refute grep -q '^\*\.' "$OUT/Caddyfile"
  refute grep -q 'acme_dns' "$OUT/Caddyfile"
  [ ! -e "$OUT/caddy" ]
}

@test "admin API only on a unix socket, never on a TCP port" {
  "$RENDER" --config "$CFG" --out "$OUT"
  grep -qx '	admin unix//run/caddy/admin.sock' "$OUT/Caddyfile"
  refute grep -q '2019' "$OUT/Caddyfile"
}

@test "site snippet: security headers; tls internal only in lab mode" {
  "$RENDER" --config "$CFG" --out "$OUT"
  grep -q 'Strict-Transport-Security "max-age=31536000"' "$OUT/Caddyfile"
  grep -q 'X-Frame-Options "DENY"' "$OUT/Caddyfile"
  refute grep -q 'tls internal' "$OUT/Caddyfile"
  ADK_TLS_INTERNAL=1 "$RENDER" --config "$CFG" --out "$OUT"
  grep -qx '	tls internal' "$OUT/Caddyfile"
  refute grep -q 'acme_dns' "$OUT/Caddyfile"
}

@test "compose: caddy only, host network, no extra capabilities, sites read-only" {
  need_yaml
  "$RENDER" --config "$CFG" --out "$OUT"
  [ "$(y "$OUT/compose.yaml" 'list(c["services"])')" = "['caddy']" ]
  [ "$(y "$OUT/compose.yaml" 'c["name"]')" = "adk-test" ]
  [ "$(y "$OUT/compose.yaml" 'c["services"]["caddy"]["network_mode"]')" = "host" ]
  [ "$(y "$OUT/compose.yaml" 'c["services"]["caddy"]["cap_add"]')" = "['NET_BIND_SERVICE']" ]
  [ "$(y "$OUT/compose.yaml" 'c["services"]["caddy"]["cap_drop"]')" = "['ALL']" ]
  [ "$(y "$OUT/compose.yaml" '"./sites:/etc/caddy/sites:ro" in c["services"]["caddy"]["volumes"]')" = "True" ]
  [ "$(y "$OUT/compose.yaml" 'c["services"]["caddy"]["env_file"]')" = "['/opt/adk/secrets/caddy.env']" ]
  set_var ACME_MODE http01
  "$RENDER" --config "$CFG" --out "$OUT"
  [ "$(y "$OUT/compose.yaml" '"env_file" in c["services"]["caddy"]')" = "False" ]
  [[ "$(y "$OUT/compose.yaml" 'c["services"]["caddy"]["image"]')" == docker.io/library/caddy:*@sha256:* ]]
}

@test "invalid config or provider without module: nothing rendered" {
  set_var DNS_PROVIDER nosuchdns
  run "$RENDER" --config "$CFG" --out "$OUT"
  [ "$status" -eq 1 ]
  [ ! -e "$OUT/Caddyfile" ]
  run "$RENDER" --config "$CFG"
  [ "$status" -eq 2 ]
}

# --- sudoers --------------------------------------------------------------------------

@test "deploy sudoers rule parses and allows only deploy.sh with <project> <ref>" {
  command -v visudo > /dev/null || [ -x /usr/sbin/visudo ] || skip "visudo not installed"
  # shellcheck source=/dev/null
  source "$ROOT/test/lib/test-host.sh"
  adk_deploy_sudoers > "$BATS_TEST_TMPDIR/sudoers"
  run "$(command -v visudo || echo /usr/sbin/visudo)" -cf "$BATS_TEST_TMPDIR/sudoers"
  [ "$status" -eq 0 ]
  [ "$(grep -c '^deploy ' "$BATS_TEST_TMPDIR/sudoers")" -eq 1 ]
  grep -q '^deploy ALL=(root) NOPASSWD: /opt/adk/test/deploy.sh \^' "$BATS_TEST_TMPDIR/sudoers"
  # the argument regex (sudoers escapes the comma) accepts and refuses like the gate
  re="$(sed -n 's|^deploy ALL=(root) NOPASSWD: /opt/adk/test/deploy.sh ||p' "$BATS_TEST_TMPDIR/sudoers" | sed 's/\\,/,/')"
  for ok in "shop 0123456789abcdef0123456789abcdef01234567" "my-app v1.2.3" "ab v1.0.0-rc.1"; do
    [[ "$ok" =~ $re ]] || { echo "refused: $ok"; return 1; }
  done
  for bad in "shop" "shop main" "shop v1.2.3 x" "shop;id v1.2.3" "../x v1.2.3" "Shop v1.2.3" "shop v1.2.3 " " shop v1.2.3"; do
    if [[ "$bad" =~ $re ]]; then echo "accepted: $bad"; return 1; fi
  done
}

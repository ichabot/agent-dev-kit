#!/usr/bin/env python3
"""Fake docker for tests/gitea-init.bats: emulates `docker compose ... exec -T -u git gitea CMD`
for the Gitea CLI, sqlite3 and curl calls of agent/gitea-init.sh. Never touches the network.

Env: FAKE_STATE (JSON file with users, tokens, orgs, teams), FAKE_LOG (one line per call,
secrets masked as <token>). Setup the state with tests/fixtures/fake-docker init.
"""
import json
import os
import re
import secrets
import sys

STATE = os.environ["FAKE_STATE"]


def load():
    with open(STATE) as f:
        return json.load(f)


def save(s):
    with open(STATE, "w") as f:
        json.dump(s, f)


def log(line):
    with open(os.environ["FAKE_LOG"], "a") as f:
        f.write(line + "\n")


args = sys.argv[1:]
if args == ["init"]:
    save({"users": {}, "tokens": [], "orgs": {}, "teams": {}, "next_id": 1})
    sys.exit(0)

# docker compose -f F exec -T -u git gitea CMD...
if args[:1] != ["compose"] or "exec" not in args:
    print("fake docker: unsupported call: " + " ".join(args), file=sys.stderr)
    sys.exit(99)
i = args.index("exec") + 1
while args[i].startswith("-"):
    i += 2 if args[i] in ("-u", "--user", "-w", "-e") else 1
service, cmd = args[i], args[i + 1:]
assert service == "gitea", service
s = load()
masked = " ".join("<token>" if re.fullmatch(r"[0-9a-f]{40}", a) else a for a in cmd)
log(masked)


def new_id():
    s["next_id"] += 1
    return s["next_id"]


def flag(name, default=None):
    for j, a in enumerate(cmd):
        if a == name:
            return cmd[j + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return default


if cmd[:3] == ["gitea", "admin", "user"]:
    sub = cmd[3]
    if sub == "list":
        print("ID   Username        Email                 IsActive IsAdmin 2FA   Type")
        for name, u in s["users"].items():
            print(f"{u['id']}    {name}  {u['email']}  true  {str(u['admin']).lower()}  false  {u['type']}")
    elif sub == "create":
        name = flag("--username")
        if name.lower() in (n.lower() for n in s["users"]):
            print("user already exists", file=sys.stderr)
            sys.exit(1)
        utype = flag("--user-type", "individual")
        u = {"id": new_id(), "email": flag("--email"), "admin": "--admin" in cmd,
             "type": utype, "must_change": False, "password": None}
        if "--random-password" in cmd:
            u["password"] = "Pw-" + secrets.token_hex(8)
            print(f"generated random password is '{u['password']}'")
        mc = flag("--must-change-password")
        u["must_change"] = (mc == "true") if mc is not None else (utype == "individual" and bool(s["users"]))
        s["users"][name] = u
        print(f"New user '{name}' has been successfully created!")
    elif sub == "generate-access-token":
        name = flag("--username")
        tok = secrets.token_hex(20)
        s["tokens"].append({"name": flag("--token-name"), "user": name, "token": tok,
                            "scopes": flag("--scopes")})
        print(tok if "--raw" in cmd else f"Access token was successfully created: {tok}")
    elif sub == "must-change-password":
        unset = "--unset" in cmd
        names = [a for a in cmd[4:] if not a.startswith("-")]
        for n in names:
            s["users"][n]["must_change"] = not unset
        print(f"Updated {len(names)} users setting MustChangePassword to {not unset}")
    else:
        sys.exit(98)
    save(s)
    sys.exit(0)

if cmd[:2] == ["gitea", "dump"]:
    if os.environ.get("FAKE_DUMP_FAIL"):
        print("fake dump failure", file=sys.stderr)
        sys.exit(1)
    import io
    import tarfile
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w:gz") as tf:
        for name, data in (("gitea-db.sql", b"CREATE TABLE t (x);\n"), ("app.ini", b"[server]\n"),
                           ("repos/acme/demo.git/HEAD", b"ref: refs/heads/main\n")):
            info = tarfile.TarInfo(name)
            info.size = len(data)
            tf.addfile(info, io.BytesIO(data))
    sys.stdout.buffer.write(buf.getvalue())
    sys.exit(0)

if cmd[0] == "sqlite3":
    q = cmd[2]
    m = re.match(r"SELECT must_change_password FROM \"user\" WHERE lower_name = '([^']+)';", q)
    if m:
        u = next((u for n, u in s["users"].items() if n.lower() == m.group(1)), None)
        print("1" if u and u["must_change"] else ("0" if u else ""))
        sys.exit(0)
    m = re.match(r"SELECT id FROM \"user\" WHERE lower_name = '([^']+)';", q)
    if m:
        u = next((u for n, u in s["users"].items() if n.lower() == m.group(1)), None)
        print(u["id"] if u else "")
        sys.exit(0)
    m = re.match(r"DELETE FROM access_token WHERE name = '([^']+)';", q)
    if m:
        s["tokens"] = [t for t in s["tokens"] if t["name"] != m.group(1)]
        save(s)
        sys.exit(0)
    m = re.match(r"DELETE FROM access_token WHERE uid = (\d+) AND name LIKE 'hermes-%' AND name <> '([^']+)';", q)
    if m:
        uid = int(m.group(1))
        owner = next(n for n, u in s["users"].items() if u["id"] == uid)
        s["tokens"] = [t for t in s["tokens"]
                       if not (t["user"] == owner and t["name"].startswith("hermes-") and t["name"] != m.group(2))]
        save(s)
        sys.exit(0)
    print("fake sqlite3: unsupported query: " + q, file=sys.stderr)
    sys.exit(97)

if cmd[0] == "curl":
    method, data, url, headers = "GET", None, None, []
    j = 1
    while j < len(cmd):
        a = cmd[j]
        if a == "-X":
            method = cmd[j + 1]; j += 2; continue
        if a == "-H":
            h = cmd[j + 1]
            headers += sys.stdin.read().splitlines() if h == "@-" else [h]
            j += 2; continue
        if a == "--data-binary":
            data = json.loads(cmd[j + 1]); j += 2; continue
        if a == "-w":
            j += 2; continue
        if a.startswith("http://"):
            url = a
        j += 1
    path = url.split("/api/v1", 1)[1].split("?")[0]
    log(f"API {method} {path} {json.dumps(data) if data is not None else ''}".rstrip())

    def reply(code, body=None):
        print(json.dumps(body if body is not None else {}))
        print(code, end="")
        save(s)
        sys.exit(0)

    auth = next((h.split(" ", 2)[2] for h in headers if h.lower().startswith("authorization: token ")), "")
    tok = next((t for t in s["tokens"] if t["token"] == auth), None)
    if not tok:
        reply(401, {"message": "invalid token"})
    doer = tok["user"]
    if s["users"][doer]["must_change"]:
        reply(403, {"message": "You must change your password."})
    if method == "GET" and path == "/user":
        reply(200, {"login": doer})
    m = re.fullmatch(r"/orgs/([^/]+)", path)
    if m and method == "GET":
        o = s["orgs"].get(m.group(1))
        reply(200, o) if o else reply(404)
    if path == "/orgs" and method == "POST":
        org = data["username"]
        owners = new_id()
        s["teams"][str(owners)] = {"id": owners, "org": org, "name": "Owners", "members": [doer],
                                   "includes_all_repositories": True, "can_create_org_repo": True,
                                   "units_map": {}, "permission": "owner"}
        s["orgs"][org] = {"username": org, "visibility": data["visibility"]}
        reply(201, s["orgs"][org])
    m = re.fullmatch(r"/orgs/([^/]+)/teams", path)
    if m and method == "GET":
        reply(200, [t for t in s["teams"].values() if t["org"] == m.group(1)])
    if m and method == "POST":
        tid = new_id()
        t = dict(data, id=tid, org=m.group(1), members=[])
        s["teams"][str(tid)] = t
        reply(201, t)
    m = re.fullmatch(r"/teams/(\d+)", path)
    if m and method == "PATCH":
        s["teams"][m.group(1)].update(data)
        reply(200, s["teams"][m.group(1)])
    m = re.fullmatch(r"/teams/(\d+)/members/([^/]+)", path)
    if m:
        t = s["teams"][m.group(1)]
        if method == "GET":
            reply(200, {"login": m.group(2)}) if m.group(2) in t["members"] else reply(404)
        if method == "PUT":
            t["members"].append(m.group(2))
            reply(204)
    reply(404, {"message": "fake: unknown route"})

print("fake docker: unsupported command: " + " ".join(cmd), file=sys.stderr)
sys.exit(96)

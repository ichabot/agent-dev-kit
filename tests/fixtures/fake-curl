#!/usr/bin/env python3
"""Fake curl for tests/provision.bats: emulates the few Hetzner Cloud API calls of
agent/provision.sh. Never touches the network.

Env: FAKE_LOG (requests, one "METHOD PATH BODY" line each), FAKE_ARGV (argv per call),
FAKE_FP (MD5 fingerprint of the test key without "MD5:"), FAKE_TOKEN (expected bearer
token), FAKE_STATE:
  empty          nothing exists
  existing       key, firewall and server (firewall attached, backups on)
  nofw           server without the kit firewall attached (apply_to_resources)
  nobackup       server exists, backups off
  extrafw        server has a second, foreign firewall attached
  othercustomer  server labelled for another customer
  foreign        server without the managed-by label
  fwforeign      firewall with the kit's name but without labels
  badkey         ssh key name taken by a different key
  fpreuse        same key already uploaded under another name
  actionerror    the server create action fails
  actiontimeout  actions never finish
  html           the API answers with a non-JSON body (proxy error page)
  badid          the server id in the response is not a number
  unauthorized   every request gets 401
"""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_ARGV"], "a") as f:
    f.write(" ".join(args) + "\n")

method, out, body, headers, url = "GET", None, None, [], None
i = 0
while i < len(args):
    a = args[i]
    if a == "-X":
        method = args[i + 1]; i += 2; continue
    if a == "-o":
        out = args[i + 1]; i += 2; continue
    if a == "--data-binary":
        body = open(args[i + 1][1:]).read(); i += 2; continue
    if a == "-H":
        h = args[i + 1]
        headers += open(h[1:]).read().splitlines() if h.startswith("@") else [h]
        i += 2; continue
    if a in ("-w", "--proto", "--max-time", "--retry"):
        i += 2; continue
    if a.startswith("https://"):
        url = a
    i += 1

path = url.split("/v1", 1)[1]
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(f"{method} {path} {json.dumps(json.loads(body)) if body else ''}".rstrip() + "\n")

state = os.environ.get("FAKE_STATE", "empty")
fp = os.environ.get("FAKE_FP", "")
labels = {"managed-by": "agent-dev-kit", "customer": "acme"}
server = {"id": 33, "name": "adk-acme-agent", "labels": labels, "backup_window": "22-02",
          "public_net": {"ipv4": {"ip": "203.0.113.50"}, "ipv6": {"ip": "2001:db8:5::/64"},
                         "firewalls": [{"id": 22, "status": "applied"}]}}
if state == "nofw":
    server["public_net"] = dict(server["public_net"], firewalls=[])
if state == "extrafw":
    server["public_net"] = dict(server["public_net"],
                                firewalls=[{"id": 22, "status": "applied"}, {"id": 99, "status": "applied"}])
if state == "othercustomer":
    server["labels"] = {"managed-by": "agent-dev-kit", "customer": "other"}
if state == "foreign":
    server["labels"] = {}
if state == "badid":
    server["id"] = "33/../../ssh_keys"
SERVER_EXISTS = state in ("existing", "nofw", "nobackup", "extrafw", "othercustomer", "foreign", "badid")
FIREWALL_EXISTS = SERVER_EXISTS or state == "fwforeign"


def respond(code, data):
    with open(out, "w") as f:
        if isinstance(data, str):
            f.write(data)
        else:
            json.dump(data, f)
    sys.stdout.write(str(code))
    sys.exit(0)


if f"Authorization: Bearer {os.environ.get('FAKE_TOKEN')}" not in headers or state == "unauthorized":
    respond(401, {"error": {"code": "unauthorized", "message": "unable to authenticate"}})

if state == "html" and path.startswith("/servers?name="):
    respond(502, "<html><body>502 Bad Gateway</body></html>")

if method == "GET" and path.startswith("/ssh_keys?name="):
    if SERVER_EXISTS:
        respond(200, {"ssh_keys": [{"id": 11, "name": "adk-acme-installer", "fingerprint": fp}]})
    if state == "badkey":
        respond(200, {"ssh_keys": [{"id": 11, "name": "adk-acme-installer", "fingerprint": "00:11"}]})
    respond(200, {"ssh_keys": []})
if method == "GET" and path.startswith("/ssh_keys?fingerprint="):
    if state == "fpreuse":
        respond(200, {"ssh_keys": [{"id": 12, "name": "laptop", "fingerprint": fp}]})
    respond(200, {"ssh_keys": []})
if method == "POST" and path == "/ssh_keys":
    respond(201, {"ssh_key": {"id": 11, "name": "adk-acme-installer", "fingerprint": fp}})
if method == "GET" and path.startswith("/firewalls?name="):
    if state == "fwforeign":
        respond(200, {"firewalls": [{"id": 22, "name": "adk-acme-agent", "labels": {}}]})
    if FIREWALL_EXISTS:
        respond(200, {"firewalls": [{"id": 22, "name": "adk-acme-agent", "labels": labels}]})
    respond(200, {"firewalls": []})
if method == "POST" and path == "/firewalls":
    respond(201, {"firewall": {"id": 22, "name": "adk-acme-agent", "labels": labels}, "actions": []})
if method == "POST" and path == "/firewalls/22/actions/set_rules":
    respond(201, {"actions": [{"id": 46, "status": "running"}]})
if method == "POST" and path == "/firewalls/22/actions/apply_to_resources":
    respond(201, {"actions": [{"id": 47, "status": "running"}]})
if method == "GET" and path.startswith("/servers?name="):
    if SERVER_EXISTS:
        respond(200, {"servers": [server]})
    respond(200, {"servers": []})
if method == "POST" and path == "/servers":
    respond(201, {"server": dict(server, backup_window=None), "action": {"id": 44, "status": "running"}})
if method == "GET" and path == "/servers/33":
    respond(200, {"server": dict(server, backup_window=None if state in ("empty", "nobackup", "fpreuse") else "22-02")})
if method == "POST" and path == "/servers/33/actions/enable_backup":
    respond(201, {"action": {"id": 45, "status": "running"}})
if method == "GET" and path.startswith("/actions/"):
    action_id = int(path.rsplit("/", 1)[1])
    if state == "actionerror" and action_id == 44:
        respond(200, {"action": {"id": 44, "status": "error", "error": {"code": "x", "message": "boom"}}})
    if state == "actiontimeout":
        respond(200, {"action": {"id": action_id, "status": "running"}})
    respond(200, {"action": {"id": action_id, "status": "success"}})
respond(404, {"error": {"code": "not_found", "message": f"fake: no route {method} {path}"}})

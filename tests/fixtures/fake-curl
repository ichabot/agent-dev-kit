#!/usr/bin/env python3
"""Fake curl for tests/provision.bats: emulates the few Hetzner Cloud API calls of
agent/provision.sh. Never touches the network.

Env: FAKE_LOG (requests, one "METHOD PATH BODY" line each), FAKE_ARGV (argv per call),
FAKE_STATE (empty | existing | foreign | badkey | unauthorized), FAKE_FP (MD5 fingerprint
of the test key without "MD5:"), FAKE_TOKEN (expected bearer token).
"""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_ARGV"], "a") as f:
    f.write(" ".join(args) + "\n")

method, out, body, headers, url = "GET", None, None, [], None
i = 0
while i < len(args):
    a = args[i]
    if a == "-X":
        method = args[i + 1]; i += 2; continue
    if a == "-o":
        out = args[i + 1]; i += 2; continue
    if a == "--data-binary":
        body = open(args[i + 1][1:]).read(); i += 2; continue
    if a == "-H":
        h = args[i + 1]
        headers += open(h[1:]).read().splitlines() if h.startswith("@") else [h]
        i += 2; continue
    if a in ("-w", "--proto", "--max-time", "--retry"):
        i += 2; continue
    if a.startswith("https://"):
        url = a
    i += 1

path = url.split("/v1", 1)[1]
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(f"{method} {path} {json.dumps(json.loads(body)) if body else ''}".rstrip() + "\n")

state = os.environ.get("FAKE_STATE", "empty")
fp = os.environ.get("FAKE_FP", "")
labels = {"managed-by": "agent-dev-kit", "customer": "acme"}
server = {"id": 33, "name": "adk-acme-agent", "labels": labels, "backup_window": None,
          "public_net": {"ipv4": {"ip": "203.0.113.50"}, "ipv6": {"ip": "2001:db8:5::/64"},
                         "firewalls": [{"id": 22, "status": "applied"}]}}


def respond(code, data):
    with open(out, "w") as f:
        json.dump(data, f)
    sys.stdout.write(str(code))
    sys.exit(0)


if f"Authorization: Bearer {os.environ.get('FAKE_TOKEN')}" not in headers or state == "unauthorized":
    respond(401, {"error": {"code": "unauthorized", "message": "unable to authenticate"}})

if method == "GET" and path.startswith("/ssh_keys?name="):
    if state in ("existing", "foreign"):
        respond(200, {"ssh_keys": [{"id": 11, "name": "adk-acme-installer", "fingerprint": fp}]})
    if state == "badkey":
        respond(200, {"ssh_keys": [{"id": 11, "name": "adk-acme-installer", "fingerprint": "00:11"}]})
    respond(200, {"ssh_keys": []})
if method == "GET" and path.startswith("/ssh_keys?fingerprint="):
    respond(200, {"ssh_keys": []})
if method == "POST" and path == "/ssh_keys":
    respond(201, {"ssh_key": {"id": 11, "name": "adk-acme-installer", "fingerprint": fp}})
if method == "GET" and path.startswith("/firewalls?name="):
    if state in ("existing", "foreign"):
        respond(200, {"firewalls": [{"id": 22, "name": "adk-acme-agent", "labels": labels}]})
    respond(200, {"firewalls": []})
if method == "POST" and path == "/firewalls":
    respond(201, {"firewall": {"id": 22, "name": "adk-acme-agent", "labels": labels}, "actions": []})
if method == "POST" and path == "/firewalls/22/actions/set_rules":
    respond(201, {"actions": [{"id": 46, "status": "running"}]})
if method == "GET" and path.startswith("/servers?name="):
    if state == "existing":
        respond(200, {"servers": [dict(server, backup_window="22-02")]})
    if state == "foreign":
        respond(200, {"servers": [dict(server, labels={})]})
    respond(200, {"servers": []})
if method == "POST" and path == "/servers":
    respond(201, {"server": server, "action": {"id": 44, "status": "running"}})
if method == "GET" and path == "/servers/33":
    respond(200, {"server": dict(server, backup_window="22-02" if state == "existing" else None)})
if method == "POST" and path == "/servers/33/actions/enable_backup":
    respond(201, {"action": {"id": 45, "status": "running"}})
if method == "GET" and path.startswith("/actions/"):
    respond(200, {"action": {"id": int(path.rsplit("/", 1)[1]), "status": "success"}})
respond(404, {"error": {"code": "not_found", "message": f"fake: no route {method} {path}"}})

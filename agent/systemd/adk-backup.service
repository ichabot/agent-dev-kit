[Unit]
Description=agent-dev-kit backup (Gitea dump, secrets, home of hermes)
Documentation=file:///opt/adk/agent/backup.sh
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/adk/agent/backup.sh
# Gitea runs again even if the backup is killed or the server shuts down meanwhile
ExecStopPost=/opt/adk/agent/backup.sh --ensure-gitea
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle

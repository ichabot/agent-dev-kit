# agent-dev-kit configuration. Copy to kit.env (git-ignored) and fill in.
# Names only here, never real values or secrets.

CUSTOMER_NAME=            # short id, e.g. acme
CUSTOMER_IPS=             # static IPv4/IPv6 CIDRs, comma separated

# VPN (set up separately). Hermes Desktop connects over SSH, so Hermes
# itself listens on loopback only and needs no bind address here.
VPN_PORT=
VPN_PROTO=udp

# Domains and certificates
GITEA_DOMAIN=
TEST_DOMAIN=
ACME_EMAIL=
ACME_MODE=dns01           # dns01 | http01
DNS_PROVIDER=             # caddy-dns module name, e.g. hetzner

# Gitea administrator: the customer's employee (sets the password at first login)
GITEA_ADMIN_USER=         # 2-39 chars a-z 0-9 . _ -, not admin/root/agent-bot/prod-pull
GITEA_ADMIN_EMAIL=

# Hetzner Cloud
HCLOUD_LOCATION=nbg1
AGENT_TYPE=               # ~4 vCPU / 8 GB
TEST_TYPE=                # ~2 vCPU / 4 GB

# Optional off-site backup (encrypted with age before it leaves the server)
BACKUP_TARGET=            # e.g. sftp://user@storagebox/backups
BACKUP_AGE_RECIPIENT=     # required with BACKUP_TARGET: age public key (age1...) of the customer
